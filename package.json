{
  "name": "one-piece",
  "private": true,
  "version": "0.0.0",
  "description": "Systems engineering SaaS PoC for hardware (all team sizes; small teams first)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w @one-piece/web",
    "clean": "rm -rf packages/*/dist apps/*/dist apps/web/dist"
  },
  "engines": {
    "node": ">=20"
  }
}
