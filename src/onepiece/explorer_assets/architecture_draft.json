      ],
      "rationale": "The mission is an integrated physical demonstration of the complete three-wheel Cube; it remains a system-level responsibility.",
      "scope": "system"
    },
    {
      "source": "C-BUDGET",
      "targets": [
        "cube.system"
      ],
      "rationale": "The prototype cost limit applies to the total onboard assembly. No per-component budget has been invented.",
      "scope": "system"
    },
    {
      "source": "C-JAPAN",
      "targets": [
        "cube.component.frame-housing",
        "cube.component.vertex-contact",
        "cube.component.reaction-wheels",
        "cube.component.motor-drivers",
        "cube.component.imu",
        "cube.component.controller",
        "cube.component.power-bus"
      ],
      "rationale": "Supply availability applies to purchased components and materials across the onboard assembly; fulfillment remains to be checked.",
      "scope": "crosscutting"
    },
    {
      "source": "C-PRINT",
      "targets": [
        "cube.component.frame-housing"
      ],
      "rationale": "The printed housing owns material and printer-envelope compatibility; specific approved values remain unresolved.",
      "scope": "local"
    },
    {
      "source": "C-FIT-MATERIAL",
      "targets": [
        "cube.component.frame-housing"
      ],
      "rationale": "The printed housing owns material and printer-envelope compatibility; specific approved values remain unresolved.",
      "scope": "local"
    },
    {
      "source": "C-FIT-PRINT",
      "targets": [
        "cube.component.frame-housing"
      ],
      "rationale": "The printed housing owns material and printer-envelope compatibility; specific approved values remain unresolved.",
      "scope": "local"
    },
    {
      "source": "C-FIT-INSTALL",
      "targets": [
        "cube.component.frame-housing",
        "cube.component.reaction-wheels",
        "cube.component.motor-drivers",
        "cube.component.imu",
        "cube.component.controller",
        "cube.component.power-bus"
      ],
      "rationale": "Installation fit is an interface responsibility shared by the housing and each installed assembly. These links do not establish dimensional compliance.",
      "scope": "shared"
    },
    {
      "source": "R-HOLD",
      "targets": [
        "cube.function.control-balance",
        "cube.function.maintain-contact"
      ],
      "rationale": "Balance control owns the active performance; vertex support and contact are shared contributors where applicable.",
      "scope": "shared"
    },
    {
      "source": "R-RMS",
      "targets": [
        "cube.function.control-balance"
      ],
      "rationale": "Balance control owns the active performance; vertex support and contact are shared contributors where applicable.",
      "scope": "local"
    },
    {
      "source": "R-TILT",
      "targets": [
        "cube.function.control-balance",
        "cube.function.maintain-contact"
      ],
      "rationale": "Balance control owns the active performance; vertex support and contact are shared contributors where applicable.",
      "scope": "shared"
    },
    {
      "source": "R-DRIFT",
      "targets": [
        "cube.function.control-balance",
        "cube.function.maintain-contact"
      ],
      "rationale": "Balance control owns the active performance; vertex support and contact are shared contributors where applicable.",
      "scope": "shared"
    },
    {
      "source": "R-REPEAT",
      "targets": [
        "cube.function.control-balance",
        "cube.function.evaluate-trace"
      ],
      "rationale": "Control must reproduce the physical hold behavior; the test evaluator determines the repeated-trial result.",
      "scope": "shared"
    },
    {
      "source": "R-DRIVE-TORQUE",
      "targets": [
        "cube.function.generate-torque"
      ],
      "rationale": "Reaction-torque generation owns motor torque and wheel-speed operating envelopes.",
      "scope": "local"
    },
    {
      "source": "R-DRIVE-SPEED",
      "targets": [
        "cube.function.generate-torque"
      ],
      "rationale": "Reaction-torque generation owns motor torque and wheel-speed operating envelopes.",
      "scope": "local"
    },
    {
      "source": "R-DRIVE-CURRENT",
      "targets": [
        "cube.function.manage-power"
      ],
      "rationale": "Power and protection behavior owns electrical and thermal limits and routes them to the participating hardware.",
      "scope": "local"
    },
    {
      "source": "R-DRIVE-VOLTAGE",
      "targets": [
        "cube.function.manage-power"
      ],
      "rationale": "Power and protection behavior owns electrical and thermal limits and routes them to the participating hardware.",
      "scope": "local"
    },
    {
      "source": "R-DRIVE-TEMP",
      "targets": [
        "cube.function.manage-power"
      ],
      "rationale": "Power and protection behavior owns electrical and thermal limits and routes them to the participating hardware.",
      "scope": "local"
    },
    {
      "source": "R-YAW",
      "targets": [
        "cube.function.estimate-attitude"
      ],
      "rationale": "The state estimator supplies the yaw-rate RMS that must be monitored during the hold interval.",
      "scope": "local"
    },
    {
      "source": "R-VISION",
      "targets": [
        "cube.function.measure-motion"
      ],
      "rationale": "Independent physical metrology owns measurement uncertainty; onboard sensor estimates are a separate measurement path.",
      "scope": "local"
    },
    {
      "source": "R-SYNC",
      "targets": [
        "cube.function.capture-synchronize"
      ],
      "rationale": "External acquisition owns the video-to-MCU time relation and its uncertainty.",
      "scope": "local"
    },
    {
      "source": "R-MODEL",
      "targets": [
        "cube.function.measure-motion",
        "cube.function.evaluate-trace"
      ],
      "rationale": "Independent measurement supplies physical data and the evaluator compares it with model results under matching conditions.",
      "scope": "shared"
    },
    {
      "source": "R-TRACE",
      "targets": [
        "cube.function.capture-synchronize",
        "cube.function.evaluate-trace"
      ],
      "rationale": "Acquisition records run provenance and evaluation binds it to exact model and requirement revisions.",
      "scope": "shared"
    }
