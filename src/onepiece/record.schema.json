{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://one-piece.engineering/schemas/record-1.0.json",
  "title": "One Piece Engineering record envelope v1.0",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "id",
    "revision",
    "kind",
    "product_node",
    "created_at",
    "actor",
    "data",
    "links",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
    },
    "kind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,79}$"
    },
    "product_node": {
      "type": "string",
      "minLength": 1,
      "pattern": ".*\\S.*"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "agent",
            "automation"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "data": {
      "type": "object"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "target"
        ],
        "properties": {
          "type": {
            "enum": [
              "derive",
              "satisfy",
              "verify",
              "allocate",
              "constrain"
            ]
          },
          "target": {
            "type": "object",
            "required": [
              "id",
              "revision"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
              },
              "revision": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "uri": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "baseline"
          }
        }
      },
      "then": {
        "properties": {
          "actor": {
            "properties": {
              "type": {
                "const": "human"
              }
            }
          },
          "data": {
            "required": [
              "members",
              "reason"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": ".*\\S.*"
              },
              "members": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "revision",
                    "sha256"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,199}$"
                    },
                    "revision": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,79}$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  ]
}
